<Window x:Class="MemoMind.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MemoMind.App.ViewModels"
        xmlns:views="clr-namespace:MemoMind.App.Views"
        mc:Ignorable="d"
        Title="心安·MemoMind" Height="720" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TaskBoardViewModel}">
            <views:TaskBoardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ChatViewModel}">
            <views:ChatView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FileWorkspaceViewModel}">
            <views:FileWorkspaceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CyberPlantViewModel}">
            <views:CyberPlantView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource SidebarBrush}" Padding="20">
            <StackPanel>
                <TextBlock Text="心安·MemoMind" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,24" />
                <TextBlock Text="Windows 桌面版 AI 心灵伙伴" Foreground="#D8E3FF" Margin="0,0,0,24" TextWrapping="Wrap" />

                <ItemsControl ItemsSource="{Binding SidebarPages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Title}"
                                    Margin="0,0,0,10"
                                    Style="{StaticResource SidebarButtonStyle}"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Id}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding CurrentPageTitle}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,16" />
            <ContentControl Grid.Row="1" Content="{Binding CurrentPageViewModel}" />
        </Grid>
    </Grid>
</Window>
