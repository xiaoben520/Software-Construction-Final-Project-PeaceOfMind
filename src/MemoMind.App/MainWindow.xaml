<Window x:Class="MemoMind.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MemoMind.App.ViewModels"
        xmlns:views="clr-namespace:MemoMind.App.Views"
        mc:Ignorable="d"
        Title="心安·MemoMind" Height="720" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TaskBoardViewModel}">
            <views:TaskBoardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ChatViewModel}">
            <views:ChatView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FileWorkspaceViewModel}">
            <views:FileWorkspaceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PomodoroAlarmViewModel}">
            <views:PomodoroAlarmView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CyberPlantViewModel}">
            <views:CyberPlantView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource SidebarBrush}" Padding="20">
            <StackPanel>
                <TextBlock Text="心安·MemoMind" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,24" />
                <TextBlock Text="Windows 桌面版 AI 心灵伙伴" Foreground="#D8E3FF" Margin="0,0,0,24" TextWrapping="Wrap" />

                <ItemsControl ItemsSource="{Binding SidebarPages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Title}"
                                    Margin="0,0,0,10"
                                    Style="{StaticResource SidebarButtonStyle}"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Id}">
                                <Button.ToolTip>
                                    <ToolTip MaxWidth="300" Padding="10" Visibility="Collapsed">
                                        <ToolTip.Style>
                                            <Style TargetType="ToolTip">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Id}" Value="task-board">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ToolTip.Style>
                                        <StackPanel>
                                            <TextBlock Text="任务总览" FontWeight="Bold" FontSize="13"
                                                       Margin="0,0,0,6"
                                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                                            <ItemsControl x:Name="TaskList" ItemsSource="{Binding PageViewModel.Tasks}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                                            <TextBlock Text="•" Width="14" FontSize="12"
                                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                                            <TextBlock Text="{Binding Title}" FontSize="12"
                                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                                       MaxWidth="180" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Status}" FontSize="11"
                                                                       Margin="10,0,0,0"
                                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="暂无任务" FontSize="12"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       Margin="0,2,0,0" Visibility="Collapsed">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PageViewModel.Tasks.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </ToolTip>
                                </Button.ToolTip>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding CurrentPageTitle}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,16" />
            <ContentControl Grid.Row="1" Content="{Binding CurrentPageViewModel}" />
        </Grid>
    </Grid>
</Window>
