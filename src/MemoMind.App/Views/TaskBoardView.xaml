<UserControl x:Class="MemoMind.App.Views.TaskBoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Clock Card -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12" Padding="14,10">
            <StackPanel Orientation="Horizontal">
                <Button Content="📅" FontSize="18" Padding="4,2"
                        Style="{StaticResource SidebarButtonStyle}"
                        Command="{Binding OpenCalendarCommand}" Margin="0,0,10,0" />
                <TextBlock Text="{Binding CurrentDate}" FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding CurrentDayOfWeek}" FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryTextBrush}" Margin="16,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding CurrentTime}" FontSize="26" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryTextBrush}" Margin="16,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding TodaySummary}" FontSize="14"
                           Foreground="{DynamicResource SecondaryTextBrush}" Margin="20,0,0,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <!-- Unified Control Panel -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <StackPanel>
                <!-- Create/Edit Panel (hidden by default) -->
                <StackPanel x:Name="CreateEditContent" Margin="0,0,0,8">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCreatePanelVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <!-- Create Mode -->
                    <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}">
                        <WrapPanel>
                            <TextBox Width="240" Margin="0,0,10,0" Padding="10,6"
                                     Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Width="200" Margin="0,0,10,0" Padding="10,6"
                                     Text="{Binding NewTaskDescription, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>
                        <WrapPanel Margin="0,10,0,0">
                            <DatePicker Width="150" Margin="0,0,10,0"
                                        SelectedDate="{Binding NewTaskDueDate}" />
                            <ToggleButton Content="🔴 紧急" Margin="0,0,10,0" Padding="10,6"
                                          IsChecked="{Binding NewTaskIsUrgent}"
                                          IsEnabled="{Binding IsUrgentEnabled}"
                                          VerticalContentAlignment="Center">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                        <Setter Property="BorderBrush" Value="#CCC" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Opacity" Value="1" />
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Background" Value="#FF4444" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="BorderThickness" Value="0" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.4" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <Button Content="+ 添加任务" Padding="16,8" Margin="0,0,10,0"
                                    Style="{StaticResource SidebarButtonStyle}"
                                    Command="{Binding AddTaskCommand}" />
                            <Button Content="取消" Padding="16,8"
                                    Style="{StaticResource SidebarButtonStyle}"
                                    Command="{Binding CancelCreateCommand}" />
                        </WrapPanel>
                    </StackPanel>
                    <!-- Edit Mode -->
                    <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
                        <WrapPanel>
                            <TextBox Width="240" Margin="0,0,10,0" Padding="10,6"
                                     Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Width="200" Margin="0,0,10,0" Padding="10,6"
                                     Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>
                        <WrapPanel Margin="0,10,0,0">
                            <DatePicker Width="150" Margin="0,0,10,0"
                                        SelectedDate="{Binding EditDueDate}" />
                            <ToggleButton Content="🔴 紧急" Margin="0,0,10,0" Padding="10,6"
                                          IsChecked="{Binding EditIsUrgent}"
                                          VerticalContentAlignment="Center">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                        <Setter Property="BorderBrush" Value="#CCC" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Background" Value="#FF4444" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="BorderThickness" Value="0" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <ComboBox Width="100" Margin="0,0,10,0"
                                      SelectedItem="{Binding EditStatus}"
                                      VerticalContentAlignment="Center">
                                <sys:String>Todo</sys:String>
                                <sys:String>Doing</sys:String>
                                <sys:String>Done</sys:String>
                            </ComboBox>
                            <Button Content="保存" Padding="16,8" Margin="0,0,10,0"
                                    Style="{StaticResource SidebarButtonStyle}"
                                    Command="{Binding SaveEditCommand}" />
                            <Button Content="取消" Padding="16,8"
                                    Style="{StaticResource SidebarButtonStyle}"
                                    Command="{Binding CancelEditCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Filter Bar -->
                <WrapPanel Visibility="{Binding IsFilterVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                           Margin="0,0,0,10">
                    <TextBlock Text="筛选：" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold" />
                    <ComboBox Width="120" ItemsSource="{Binding StatusFilterOptions}"
                              SelectedItem="{Binding StatusFilter}"
                              VerticalContentAlignment="Center" />
                    <Button Content="应用筛选" Padding="12,6" Margin="10,0,0,0"
                            Style="{StaticResource SidebarButtonStyle}"
                            Command="{Binding FilterCommand}" />
                </WrapPanel>

                <!-- Action Bar -->
                <WrapPanel x:Name="ActionBar">
                    <Button Content="➕ 添加" Padding="12,6" Margin="0,0,10,0"
                            Style="{StaticResource SidebarButtonStyle}"
                            Command="{Binding ToggleCreatePanelCommand}" />
                    <Button Content="✏️ 编辑" Padding="12,6" Margin="0,0,10,0"
                            Style="{StaticResource SidebarButtonStyle}"
                            Command="{Binding StartEditCommand}" />
                    <Button Content="🗑 删除" Padding="12,6" Margin="0,0,10,0"
                            Style="{StaticResource SidebarButtonStyle}"
                            Command="{Binding DeleteTaskCommand}" />
                    <Button Content="🔍 筛选" Padding="12,6"
                            Style="{StaticResource SidebarButtonStyle}"
                            Command="{Binding ToggleFilterCommand}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Task List -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <ListView x:Name="TaskBoardListView" ItemsSource="{Binding FilteredTasks}"
                      SelectedItem="{Binding SelectedTask}"
                      BorderThickness="0"
                      VirtualizingStackPanel.IsVirtualizing="False">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="14" Margin="0,0,0,12" CornerRadius="10"
                                Width="{Binding ActualWidth, ElementName=TaskBoardListView, Converter={StaticResource HalfBoardWidthConverter}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource ListItemBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUrgent}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource UrgentTaskBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="470" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Row 0: Title + Status (Col 0) | gap (Col 1) | 开工/完成 (Col 2) -->
                                <DockPanel Grid.Row="0" Grid.Column="0">
                                    <Border DockPanel.Dock="Right" CornerRadius="6" Padding="6,2" Margin="24,0,0,0" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Done">
                                                        <Setter Property="Background" Value="#4CAF50" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Doing">
                                                        <Setter Property="Background" Value="#FF9800" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Todo">
                                                        <Setter Property="Background" Value="#2196F3" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status}" Foreground="White" FontSize="11" />
                                    </Border>
                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </DockPanel>
                                <!-- 开工 button (when Todo and time picker not shown) -->
                                <Button Grid.Row="0" Grid.Column="1" Content="🚀 开工" Padding="12,6" FontSize="12" Width="90"
                                        Margin="0,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right"
                                        Command="{Binding DataContext.StartTaskCommand, Source={x:Reference TaskBoardListView}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#2196F3" />
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Status}" Value="Todo" />
                                                        <Condition Binding="{Binding IsTimePickerVisible}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Time picker (shown after clicking 开工) -->
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                                            Margin="0,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTimePickerVisible}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <ComboBox SelectedItem="{Binding EstimatedHours}" Width="44" Height="28" FontSize="13"
                                              ItemsSource="{Binding DataContext.HourOptions, Source={x:Reference TaskBoardListView}}"
                                              VerticalContentAlignment="Center" />
                                    <TextBlock Text="h" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                                               Margin="2,0,6,0" />
                                    <ComboBox SelectedItem="{Binding EstimatedMinutes}" Width="44" Height="28" FontSize="13"
                                              ItemsSource="{Binding DataContext.MinuteOptions, Source={x:Reference TaskBoardListView}}"
                                              VerticalContentAlignment="Center" />
                                    <TextBlock Text="m" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                                               Margin="2,0,8,0" />
                                    <Button Content="✅ 确认" Padding="10,6" FontSize="12"
                                            Command="{Binding DataContext.ConfirmStartCommand, Source={x:Reference TaskBoardListView}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#4CAF50" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="Cursor" Value="Hand" />
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="❌" Padding="8,6" FontSize="12"
                                            Command="{Binding DataContext.CancelTimerCommand, Source={x:Reference TaskBoardListView}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#666" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="Cursor" Value="Hand" />
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>

                                <!-- 完成 button (when Doing) -->
                                <Button Grid.Row="0" Grid.Column="1" Content="✅ 完成" Padding="12,6" FontSize="12" Width="90"
                                        Margin="0,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right"
                                        Command="{Binding DataContext.CompleteTaskCommand, Source={x:Reference TaskBoardListView}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#4CAF50" />
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Doing">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Row 1: Description (Col 0) | Countdown (Col 1) | 暂停 (Col 2) -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Description}" Margin="0,8,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CountdownDisplay}"
                                           FontSize="20" FontWeight="Bold" Margin="0,8,0,0"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="#4CAF50">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Doing">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Grid.Row="1" Grid.Column="1" Content="⏸️ 暂停" Padding="12,6" FontSize="12" Width="90"
                                        Margin="0,8,0,0" VerticalAlignment="Center" HorizontalAlignment="Right"
                                        Command="{Binding DataContext.PauseTaskCommand, Source={x:Reference TaskBoardListView}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#FF9800" />
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Doing">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Row 2: Due date (Col 0) | gap (Col 1) | 🔴 紧急 (Col 2) -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,8,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center">
                                    <Run Text="截止：" />
                                    <Run Text="{Binding DueDate, StringFormat={}{0:yyyy-MM-dd}}" />
                                </TextBlock>
                                <TextBlock Grid.Row="2" Grid.Column="1" Width="90" Margin="0,8,0,0"
                                           Foreground="#FF4444" FontWeight="Bold" TextAlignment="Right"
                                           HorizontalAlignment="Right"
                                           Visibility="{Binding IsUrgent, Converter={StaticResource BoolToVisibilityConverter}}"
                                           VerticalAlignment="Center">
                                    <Run Text="🔴 紧急" />
                                </TextBlock>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Calendar Modal Overlay -->
        <Grid Grid.RowSpan="3" Visibility="{Binding IsCalendarVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- Semi-transparent backdrop -->
            <Border Background="#80000000" />
            <!-- Calendar Panel -->
            <Border Background="{DynamicResource CardBrush}" CornerRadius="16" Padding="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="320" MaxWidth="400">
                <StackPanel>
                    <!-- + button -->
                    <Button Content="＋" FontSize="18" Padding="6,2" HorizontalAlignment="Right"
                            Style="{StaticResource SidebarButtonStyle}"
                            Command="{Binding ShowEventInputCommand}" Margin="0,0,0,8" />
                    <!-- Header: prev month + title + next month -->
                    <DockPanel Margin="0,0,0,16">
                        <Button Content="◀" FontSize="16" Padding="8,4"
                                Style="{StaticResource SidebarButtonStyle}"
                                Command="{Binding PrevMonthCommand}" DockPanel.Dock="Left" />
                        <Button Content="▶" FontSize="16" Padding="8,4"
                                Style="{StaticResource SidebarButtonStyle}"
                                Command="{Binding NextMonthCommand}" DockPanel.Dock="Right" />
                        <TextBlock Text="{Binding CalendarTitle}" FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                    </DockPanel>
                    <!-- Day headers -->
                    <UniformGrid Columns="7" Margin="0,0,0,8">
                        <TextBlock Text="日" HorizontalAlignment="Center" FontWeight="SemiBold"
                                   Foreground="#FF4444" />
                        <TextBlock Text="一" HorizontalAlignment="Center" FontWeight="SemiBold" />
                        <TextBlock Text="二" HorizontalAlignment="Center" FontWeight="SemiBold" />
                        <TextBlock Text="三" HorizontalAlignment="Center" FontWeight="SemiBold" />
                        <TextBlock Text="四" HorizontalAlignment="Center" FontWeight="SemiBold" />
                        <TextBlock Text="五" HorizontalAlignment="Center" FontWeight="SemiBold" />
                        <TextBlock Text="六" HorizontalAlignment="Center" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                    </UniformGrid>
                    <!-- Day grid -->
                    <ItemsControl ItemsSource="{Binding CalendarDays}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="42" Height="46" Margin="2" Padding="0"
                                        Command="{Binding DataContext.SelectCalendarDayCommand, Source={x:Reference TaskBoardListView}}"
                                        CommandParameter="{Binding}"
                                        BorderThickness="0" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock x:Name="dayNum" Text="{Binding Display}" HorizontalAlignment="Center"
                                                                           FontSize="13" Margin="0,0,0,1" />
                                                                <TextBlock Text="{Binding HolidayText}" HorizontalAlignment="Center"
                                                                           FontSize="9" Foreground="#FF4444"
                                                                           Visibility="{Binding HasHoliday, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                <TextBlock Text="{Binding EventText}" HorizontalAlignment="Center"
                                                                           FontSize="9" Foreground="#FF4444"
                                                                           Visibility="{Binding HasEvent, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#90CAF9" />
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                <Setter TargetName="dayNum" Property="Foreground" Value="#2196F3" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#2196F3" />
                                                                <Setter TargetName="dayNum" Property="Foreground" Value="White" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                                <Setter Property="Visibility" Value="Hidden" />
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Event Input Panel -->
                    <StackPanel Visibility="{Binding IsEventInputVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                Margin="0,12,0,0">
                        <TextBox Text="{Binding NewEventText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6" Margin="0,0,0,8" />
                        <Button Content="保存日程" Padding="12,6"
                                Style="{StaticResource SidebarButtonStyle}"
                                HorizontalAlignment="Center"
                                Command="{Binding SaveEventCommand}" />
                    </StackPanel>
                    <!-- Close button -->
                    <Button Content="关闭" Padding="12,8" Margin="0,12,0,0"
                            Style="{StaticResource SidebarButtonStyle}"
                            HorizontalAlignment="Center"
                            Command="{Binding CloseCalendarCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
