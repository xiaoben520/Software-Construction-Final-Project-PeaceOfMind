<UserControl x:Class="MemoMind.App.Views.TaskBoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="任务看板" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBlock Text="在这里先做一个最小可用的任务管理页。" Margin="0,8,0,16" Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock Text="{Binding StatusMessage}" Margin="0,0,0,16" Foreground="{DynamicResource SecondaryTextBrush}" />
                <WrapPanel>
                    <TextBox Width="260" Margin="0,0,12,0" Padding="10,6" Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}" />
                    <DatePicker Width="160" Margin="0,0,12,0" SelectedDate="{Binding NewTaskDueDate}" />
                    <ComboBox Width="100" Margin="0,0,12,0" SelectedItem="{Binding NewTaskPriority}" VerticalContentAlignment="Center">
                        <sys:String>低</sys:String>
                        <sys:String>中</sys:String>
                        <sys:String>高</sys:String>
                    </ComboBox>
                    <Button Content="添加任务" Padding="18,8" Style="{StaticResource SidebarButtonStyle}" Command="{Binding AddTaskCommand}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <ListView ItemsSource="{Binding Tasks}" BorderThickness="0">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12" Margin="0,0,0,10" Background="{DynamicResource ListItemBrush}" CornerRadius="10">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" DockPanel.Dock="Left" />
                                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource SecondaryTextBrush}" DockPanel.Dock="Right" />
                                </DockPanel>
                                <TextBlock Text="{Binding Description}" Margin="0,6,0,0" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource SecondaryTextBrush}">
                                    <Run Text="截止：" />
                                    <Run Text="{Binding DueDate, StringFormat={}{0:yyyy-MM-dd}}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</UserControl>
