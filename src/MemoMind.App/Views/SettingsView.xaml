<UserControl x:Class="MemoMind.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="设置" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBlock Text="{Binding StatusMessage}" Margin="0,8,0,16" Foreground="{DynamicResource SecondaryTextBrush}" />

                <TextBlock Text="通用设置" Margin="0,0,0,10" FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" />

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="主题" />
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"
                              ItemsSource="{Binding ThemeOptions}"
                              SelectedItem="{Binding Theme}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="提醒小时" />
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" Padding="10,6"
                             Text="{Binding ReminderHour, UpdateSourceTrigger=PropertyChanged}" />

                    <CheckBox Grid.Row="2" Grid.Column="1" Content="启用每日提醒"
                              IsChecked="{Binding EnableReminder}" />
                </Grid>

                <Border Height="1" Background="{DynamicResource SecondaryTextBrush}" Opacity="0.2" Margin="0,8,0,16" />

                <TextBlock Text="AI 配置" Margin="0,0,0,10" FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBlock Text="选择热门服务商自动填入 API 地址和模型，或选择「自定义」手动输入。" Margin="0,0,0,8"
                           Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" />

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="服务商" />
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"
                              ItemsSource="{Binding ProviderOptions}"
                              DisplayMemberPath="Name"
                              SelectedIndex="{Binding SelectedProviderIndex}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="模型" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"
                              ItemsSource="{Binding ModelOptions}"
                              SelectedItem="{Binding AiModel}"
                              IsEditable="True" />

                    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="API 地址" />
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" Padding="10,6"
                             Text="{Binding AiBaseUrl, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="API Key" />
                    <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,10" Padding="10,6"
                             Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Top" Text="AI 人设" />
                    <TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,10" Padding="10,6" Height="90"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Text="{Binding AiPersona, UpdateSourceTrigger=PropertyChanged}" />

                    <CheckBox Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" Content="启用 AI"
                              IsChecked="{Binding EnableAi}" />
                </Grid>

                <Border Height="1" Background="{DynamicResource SecondaryTextBrush}" Opacity="0.2" Margin="0,8,0,16" />

                <TextBlock Text="左侧栏目显示" Margin="0,0,0,10" FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBlock Text="控制在左侧导航栏中显示哪些页面。" Margin="0,0,0,8"
                           Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" />
                <ItemsControl ItemsSource="{Binding SidebarOptions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,8">
                                <CheckBox Content="{Binding Title}" IsChecked="{Binding IsSelected}">
                                    <CheckBox.Style>
                                        <Style TargetType="CheckBox">
                                            <Setter Property="IsEnabled" Value="True" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </CheckBox.Style>
                                </CheckBox>
                                <TextBlock Text="{Binding Description}" Margin="24,2,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="主页模块显示" Margin="0,16,0,10" FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBlock Text="控制在主页中显示哪些模块卡片。" Margin="0,0,0,8"
                           Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" />
                <ItemsControl ItemsSource="{Binding HomeOptions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,8">
                                <CheckBox Content="{Binding Title}" IsChecked="{Binding IsSelected}" />
                                <TextBlock Text="{Binding Description}" Margin="24,2,0,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Height="1" Background="{DynamicResource SecondaryTextBrush}" Opacity="0.2" Margin="0,16" />

                <TextBlock Text="文件工作区模块显示" Margin="0,16,0,10" FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBlock Text="控制在文件工作区页面中显示哪些功能模块。" Margin="0,0,0,8"
                           Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" />

                <StackPanel Margin="0,0,0,8">
                    <CheckBox Content="显示「最近打开」模块 — 自动记录最近打开的文件和文件夹"
                              IsChecked="{Binding ShowRecentFiles}" Margin="0,0,0,6" />
                    <CheckBox Content="显示「保存工作区」模块 — 自定义分组管理常用文件和文件夹"
                              IsChecked="{Binding ShowWorkspaceGroups}" Margin="0,0,0,6" />
                    <CheckBox Content="显示「小文件管理器」模块 — 简化的文件浏览与管理"
                              IsChecked="{Binding ShowFileManager}" />
                </StackPanel>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center"
                               Text="保留最近打开条数（5-200）" />
                    <TextBox Grid.Column="1" Padding="8,6"
                             Text="{Binding RecentFilesLimit, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="管理器默认目录" />
                    <TextBox Grid.Column="1" Padding="10,6"
                             Text="{Binding FileManagerRootPath, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <TextBlock Text="测试工具" Margin="0,0,0,10" FontSize="18" FontWeight="SemiBold"
                        Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBlock Text="用于测试环境清理：删除本地数据库后需重启应用。" Margin="0,0,0,12"
                        Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" />
                <Button Content="删除数据库" Padding="16,8" HorizontalAlignment="Left"
                    Style="{StaticResource SidebarButtonStyle}"
                    Command="{Binding DeleteDatabaseCommand}" />

                <Border Height="1" Background="{DynamicResource SecondaryTextBrush}" Opacity="0.2" Margin="0,16" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="重新加载" Margin="0,0,10,0" Padding="16,8"
                            Style="{StaticResource SidebarButtonStyle}" Command="{Binding LoadCommand}" />
                    <Button Content="保存设置" Padding="16,8"
                            Style="{StaticResource SidebarButtonStyle}" Command="{Binding SaveCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
