<Window x:Class="MemoMind.App.Views.AlarmPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="闹钟提醒" Height="280" Width="460"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Background="{DynamicResource CardBrush}" CornerRadius="18" Padding="28">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.15" />
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="{Binding PopupTitle, Mode=OneWay}" FontSize="22" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8"
                       TextWrapping="Wrap" />

            <TextBlock FontSize="15" Foreground="{DynamicResource SecondaryTextBrush}"
                       Margin="0,0,0,6">
                <Run Text="⏰ " /><Run Text="{Binding TriggerTime, Mode=OneWay, StringFormat={}{0:HH:mm:ss}}" />
            </TextBlock>

            <Border Background="{DynamicResource ListItemBrush}" CornerRadius="10" Padding="14,10"
                    Margin="0,12,0,0" MinHeight="60">
                <TextBlock Text="{Binding Message, Mode=OneWay}" FontSize="14"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
            </Border>

            <Button Content="关闭提醒" Margin="0,20,0,0" Height="42"
                    Style="{StaticResource SidebarButtonStyle}"
                    HorizontalAlignment="Center" Width="140"
                    Click="DismissButton_Click" />
        </StackPanel>
    </Border>
</Window>
