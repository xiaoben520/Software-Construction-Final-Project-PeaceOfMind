<UserControl x:Class="MemoMind.App.Views.FileWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:MemoMind.App.Models"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- ==================== Section 1: Recent Files ==================== -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"
                    Visibility="{Binding ShowRecentFiles, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="最近打开" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="自动记录最近打开的文件和文件夹，方便快速重新打开。"
                                       Margin="0,6,0,0" Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="{Binding IsRecentFilesExpanded, Converter={StaticResource BoolToCollapseTextConverter}}"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource FileWorkspaceActionButtonStyle}"
                                    Command="{Binding ToggleRecentFilesCommand}"
                                    Margin="0,0,8,0" />
                            <Button Content="清除全部" VerticalAlignment="Center"
                                    Style="{StaticResource FileWorkspaceActionButtonStyle}"
                                    Command="{Binding ClearRecentFilesCommand}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding RecentStatus}" Margin="0,8,0,8"
                               Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" />

                    <ListView ItemsSource="{Binding RecentFiles}" SelectedItem="{Binding SelectedRecentFile}"
                              BorderThickness="0" MaxHeight="320"
                              Visibility="{Binding IsRecentFilesExpanded, Converter={StaticResource BoolToVisibilityConverter}}"
                              MouseDoubleClick="RecentFiles_MouseDoubleClick">
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:RecentFileEntry}">
                                <Border Style="{StaticResource FileWorkspaceItemStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Icon}"
                                                   VerticalAlignment="Center" FontSize="18" Margin="0,0,10,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" />
                                            <TextBlock Text="{Binding Path}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                                   Text="{Binding LastOpenedAt, StringFormat='yyyy-MM-dd HH:mm'}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" />
                                    </Grid>
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="打开" Click="RecentFile_Open_Click" />
                                            <Separator />
                                            <MenuItem Header="从列表移除" Click="RecentFile_Remove_Click" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- ==================== Section 2: Workspace Groups ==================== -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"
                    Visibility="{Binding ShowWorkspaceGroups, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="保存工作区" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock Text="创建分组来组织常用文件和文件夹，自动展开子目录内容。"
                               Margin="0,6,0,0" Foreground="{DynamicResource SecondaryTextBrush}" />

                    <Grid Margin="0,12,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Padding="10,8" Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,12,0" />
                        <Button Grid.Column="1" Content="＋ 新建分组" Padding="14,8"
                                Style="{StaticResource FileWorkspaceActionButtonStyle}"
                                Command="{Binding AddGroupCommand}" />
                    </Grid>

                    <TextBlock Text="{Binding WorkspaceStatus}" Margin="0,0,0,10"
                               Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" />

                    <ItemsControl ItemsSource="{Binding WorkspaceGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:WorkspaceGroupViewModel}">
                                <Border Background="{DynamicResource ListItemBrush}" CornerRadius="12"
                                        Margin="0,0,0,12" Padding="0">
                                    <StackPanel>
                                        <!-- Group Header -->
                                        <Border Style="{StaticResource FileWorkspaceGroupHeaderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="" FontSize="16" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource SidebarButtonForegroundBrush}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button Content="展开全部" Style="{StaticResource FileWorkspaceActionButtonStyle}"
                                                            Padding="8,6" FontSize="11"
                                                            Margin="0,0,4,0"
                                                            Command="{Binding DataContext.ExpandAllCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="收起全部" Style="{StaticResource FileWorkspaceActionButtonStyle}"
                                                            Padding="8,6" FontSize="11"
                                                            Margin="0,0,6,0"
                                                            Command="{Binding DataContext.CollapseAllCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="＋ 添加" Style="{StaticResource FileWorkspaceActionButtonStyle}"
                                                            Margin="0,0,6,0"
                                                            Command="{Binding DataContext.AddItemToGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="删除" Style="{StaticResource FileWorkspaceDangerButtonStyle}"
                                                            Command="{Binding DataContext.DeleteGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Root Items (TreeView for multi-level expand/collapse) -->
                                        <TreeView ItemsSource="{Binding RootItems}" Margin="4,4,4,4"
                                                  TreeViewItem.Expanded="WorkspaceTreeItem_Expanded"
                                                  BorderThickness="0" Background="Transparent">
                                            <TreeView.ItemContainerStyle>
                                                <Style TargetType="TreeViewItem">
                                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                                    <Setter Property="Focusable" Value="False" />
                                                    <EventSetter Event="Selected" Handler="WorkspaceTreeItem_Selected" />
                                                </Style>
                                            </TreeView.ItemContainerStyle>
                                            <TreeView.ItemTemplate>
                                                <HierarchicalDataTemplate DataType="{x:Type models:WorkspaceItemViewModel}"
                                                                          ItemsSource="{Binding Children}">
                                                    <Border Style="{StaticResource FileWorkspaceItemStyle}"
                                                            MouseLeftButtonDown="WorkspaceItem_Click"
                                                            Margin="2">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="14"
                                                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                                                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                                                       VerticalAlignment="Center" FontSize="13" />
                                                        </Grid>
                                                    </Border>
                                                </HierarchicalDataTemplate>
                                            </TreeView.ItemTemplate>
                                        </TreeView>

                                        <TextBlock Text="点击文件夹可展开/折叠，使用「展开全部/收起全部」一键操作" Margin="10,4,10,8"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ==================== Section 3: Mini File Manager ==================== -->
            <Border Style="{StaticResource CardStyle}"
                    Visibility="{Binding ShowFileManager, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="小文件管理器" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="管理多个目录，支持打开、新建、重命名、移除显示和删除操作。"
                                       Margin="0,6,0,0" Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="添加目录" VerticalAlignment="Center"
                                Style="{StaticResource FileWorkspaceActionButtonStyle}" Padding="14,8"
                                Command="{Binding AddRootPathCommand}" />
                    </Grid>

                    <!-- Root directories list -->
                    <ItemsControl ItemsSource="{Binding FileManagerRootPaths}" Margin="0,8,0,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource ListItemBrush}" CornerRadius="6"
                                        Padding="8,6" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="" FontSize="14"
                                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" />
                                        <Button Grid.Column="2" Content="移除" Padding="6,3" FontSize="10"
                                                Style="{StaticResource FileWorkspaceDangerButtonStyle}"
                                                Command="{Binding DataContext.RemoveRootPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding FileManagerStatus}" Margin="0,8,0,8"
                               Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" />

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: TreeView -->
                        <Border Grid.Column="0" Background="{DynamicResource ListItemBrush}" CornerRadius="10"
                                Padding="8" MinHeight="300">
                            <TreeView ItemsSource="{Binding FileManagerTree}"
                                      SelectedItemChanged="FileManagerTree_SelectedItemChanged"
                                      TreeViewItem.Expanded="FileManagerTreeItem_Expanded"
                                      TreeViewItem.Collapsed="FileManagerTreeItem_Collapsed"
                                      BorderThickness="0" Background="Transparent">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate DataType="{x:Type models:FileManagerItem}"
                                                              ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Margin="2">
                                            <CheckBox IsChecked="{Binding IsChecked}"
                                                      VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Icon}" FontSize="14" VerticalAlignment="Center"
                                                       Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"
                                                       FontSize="13" />
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Border>

                        <!-- Right: Operations Panel -->
                        <Border Grid.Column="1" Background="{DynamicResource ListItemBrush}" CornerRadius="10"
                                Padding="16" Margin="12,0,0,0" MinHeight="300">
                            <StackPanel VerticalAlignment="Top">
                                <TextBlock Text="操作面板" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,14" />

                                <TextBlock Text="当前选中：" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" />
                                <TextBlock Text="{Binding SelectedFileManagerItem.DisplayName, TargetNullValue='（未选择）'}"
                                           FontWeight="SemiBold" Margin="0,2,0,14" TextTrimming="CharacterEllipsis" />

                                <Button Content="打开" Margin="0,0,0,6" Padding="12,8"
                                        Style="{StaticResource FileWorkspaceActionButtonStyle}"
                                        Command="{Binding OpenFileManagerItemCommand}" />

                                <Button Content="移除显示" Margin="0,0,0,6" Padding="12,8"
                                        Style="{StaticResource FileWorkspaceActionButtonStyle}"
                                        Command="{Binding HideSelectedItemCommand}" />

                                <Border Height="1" Background="{DynamicResource SecondaryTextBrush}"
                                        Opacity="0.15" Margin="0,8" />

                                <TextBlock Text="重命名" FontWeight="SemiBold" Margin="0,0,0,8"
                                           Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Padding="8,6"
                                             Text="{Binding NewFileName, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,8,0" />
                                    <Button Grid.Column="1" Content="确认" Padding="10,6"
                                            Style="{StaticResource FileWorkspaceActionButtonStyle}"
                                            Command="{Binding RenameFileManagerItemCommand}" />
                                </Grid>

                                <Button Content="删除" Margin="0,10,0,0" Padding="12,8"
                                        Style="{StaticResource FileWorkspaceDangerButtonStyle}"
                                        Command="{Binding DeleteFileManagerItemCommand}" />

                                <Border Height="1" Background="{DynamicResource SecondaryTextBrush}"
                                        Opacity="0.15" Margin="0,14,0,8" />

                                <TextBlock Text="批量操作" FontWeight="SemiBold" Margin="0,0,0,8"
                                           Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" />
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="批量打开" Padding="8,8"
                                            Style="{StaticResource FileWorkspaceActionButtonStyle}"
                                            Command="{Binding OpenSelectedItemsCommand}"
                                            Margin="0,0,4,0" />
                                    <Button Grid.Column="1" Content="批量移除显示" Padding="8,8"
                                            Style="{StaticResource FileWorkspaceActionButtonStyle}"
                                            Command="{Binding HideSelectedItemsCommand}"
                                            Margin="4,0,0,0" />
                                </Grid>
                                <Button Content="批量删除（永久）" Margin="0,0,0,4" Padding="8,8"
                                        Style="{StaticResource FileWorkspaceDangerButtonStyle}"
                                        Command="{Binding DeleteSelectedItemsCommand}" />
                                <Button Content="显示全部隐藏项目" Margin="0,0,0,8" Padding="8,8"
                                        Style="{StaticResource FileWorkspaceActionButtonStyle}"
                                        Command="{Binding ShowAllCommand}" />

                                <Border Height="1" Background="{DynamicResource SecondaryTextBrush}"
                                        Opacity="0.15" Margin="0,14,0,8" />

                                <TextBlock Text="新建文件" FontWeight="SemiBold" Margin="0,0,0,8"
                                           Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Padding="8,6"
                                             Text="{Binding NewFileName, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,8,0" />
                                    <Button Grid.Column="1" Content="创建" Padding="10,6"
                                            Style="{StaticResource FileWorkspaceActionButtonStyle}"
                                            Command="{Binding AddNewFileCommand}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
