<!--
    ChatView.xaml — AI 聊天页面 UI 布局
    结构：上半部分消息列表（自适应高度），下半部分输入栏（固定底部）
    消息气泡：AI 左对齐灰色圆角气泡，用户右对齐蓝色(#4A90D9)圆角气泡，系统消息以"系统"发送者展示工具结果 -->
<UserControl x:Class="MemoMind.App.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />     <!-- 消息列表：撑满剩余空间 -->
            <RowDefinition Height="Auto" />   <!-- 输入栏：固定高度，底部对齐 -->
        </Grid.RowDefinitions>

        <!-- 消息列表区域 -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
            <DockPanel>
                <!-- 标题 + AI 状态提示 -->
                <TextBlock Text="AI 聊天" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" DockPanel.Dock="Top" />
                <TextBlock Text="{Binding AiStatus}" Margin="0,4,0,10" Foreground="{DynamicResource SecondaryTextBrush}" DockPanel.Dock="Top" FontSize="12" />

                <!-- 消息列表：使用 ListBox + DataTemplate 实现聊天气泡布局
                     IsUserMessage 为 true → 右对齐蓝色气泡
                     IsUserMessage 为 false → 左对齐灰色气泡 -->
                <ListBox x:Name="ChatListBox" ItemsSource="{Binding Messages}" BorderThickness="0" Background="Transparent" Margin="0,8,0,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,12">
                                <!-- AI 消息气泡 — 左对齐
                                     ConverterParameter=invert 反转 IsUserMessage：
                                     IsUserMessage=false 时显示，IsUserMessage=true 时隐藏 -->
                                <Border HorizontalAlignment="Left"
                                        Padding="12,8"
                                        Background="{DynamicResource ListItemBrush}"
                                        CornerRadius="4,14,14,14"
                                        MaxWidth="700"
                                        Visibility="{Binding IsUserMessage, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="{Binding Sender}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <TextBlock Text="{Binding Time, StringFormat={}{0:HH:mm}}" FontSize="10"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" DockPanel.Dock="Right" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="14" />
                                    </StackPanel>
                                </Border>

                                <!-- 用户消息气泡 — 右对齐
                                     IsUserMessage=true 时显示 -->
                                <Border HorizontalAlignment="Right"
                                        Padding="12,8"
                                        Background="#4A90D9"
                                        CornerRadius="14,4,14,14"
                                        MaxWidth="700"
                                        Visibility="{Binding IsUserMessage, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="{Binding Sender}" FontWeight="SemiBold" FontSize="12" Foreground="White" />
                                            <TextBlock Text="{Binding Time, StringFormat={}{0:HH:mm}}" FontSize="10"
                                                       Foreground="White" DockPanel.Dock="Right" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="14" Foreground="White" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- "正在输入..." 加载提示，仅在 IsSending 为 true 时显示 -->
                <TextBlock Text="正在输入..." Margin="0,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}"
                           FontStyle="Italic" FontSize="12" DockPanel.Dock="Bottom"
                           Visibility="{Binding IsSending, Converter={StaticResource BoolToVisibilityConverter}}" />
            </DockPanel>
        </Border>

        <!-- 输入区域：输入框 + 发送按钮 -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <DockPanel>
                <Button Content="发送" Width="90" Margin="12,0,0,0"
                        Style="{StaticResource SidebarButtonStyle}"
                        Command="{Binding SendCommand}" DockPanel.Dock="Right" />
                <TextBox Height="42" Padding="10,8"
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="ChatInput_KeyDown" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
