<UserControl x:Class="MemoMind.App.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
            <DockPanel>
                <TextBlock Text="AI 聊天" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" DockPanel.Dock="Top" />
                <ListBox ItemsSource="{Binding Messages}" BorderThickness="0" Background="Transparent" Margin="0,16,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10" Padding="12" Background="{DynamicResource ListItemBrush}" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="{Binding Sender}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Content}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <DockPanel>
                <Button Content="发送" Width="90" Margin="12,0,0,0" Style="{StaticResource SidebarButtonStyle}" Command="{Binding SendCommand}" DockPanel.Dock="Right" />
                <TextBox Height="42" Padding="10,8" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
