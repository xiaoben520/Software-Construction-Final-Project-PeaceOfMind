<UserControl x:Class="MemoMind.App.Views.CyberPlantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Panel: Plant Selection & Status -->
        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,16,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="赛博植物" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock Text="{Binding StatusMessage}" Margin="0,6,0,16" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" FontSize="12" />

                    <!-- Current Plant Status Card -->
                    <Border Background="{DynamicResource ListItemBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding PlantEmoji, Mode=OneWay}" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding PlantName, Mode=OneWay}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}">
                                <Run Text="性格：" /><Run Text="{Binding PlantPersonality, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding GrowthDisplay, Mode=OneWay}" FontSize="16" HorizontalAlignment="Center" Margin="0,8,0,0" />
                            <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}">
                                <Run Text="心情：" /><Run Text="{Binding Mood, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding WaterStatusDisplay, Mode=OneWay}" Margin="0,6,0,0" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding NutritionStatusDisplay, Mode=OneWay}" Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding SunStatusDisplay, Mode=OneWay}" Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding LastWateredDisplay, Mode=OneWay}" Margin="0,8,0,0" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                                    <WrapPanel Margin="0,12,0,0" HorizontalAlignment="Center">
                                    <Button Content="💧 浇水" Margin="0,0,8,8" Padding="14,10" MinWidth="96" MinHeight="40"
                                    Style="{StaticResource SidebarButtonStyle}"
                                    Command="{Binding WaterCommand}" />
                                    <Button Content="🌾 施肥" Margin="0,0,8,8" Padding="14,10" MinWidth="96" MinHeight="40"
                                    Style="{StaticResource SidebarButtonStyle}"
                                    Command="{Binding FertilizeCommand}" />
                                    <Button Content="☀️ 晒太阳" Margin="0,0,0,8" Padding="14,10" MinWidth="96" MinHeight="40"
                                    Style="{StaticResource SidebarButtonStyle}"
                                    Command="{Binding SunCommand}" />
                                </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Plant Type Selection -->
                    <TextBlock Text="选择植物" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding PlantItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="10" CornerRadius="8"
                                        Background="{DynamicResource ListItemBrush}" Cursor="Hand"
                                        MouseLeftButtonDown="PlantType_Click">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                                    <Setter Property="Opacity" Value="0.5" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontSize="16">
                                                <Run Text="{Binding Emoji}" /><Run Text="  " /><Run Text="{Binding Name}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Personality}" Margin="0,2,0,0" FontSize="11"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <TextBlock Text="已隐藏" FontSize="10"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       Visibility="{Binding IsDeleted, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="⚙" Width="28" Height="28" Margin="8,0,0,0"
                                            VerticalAlignment="Top" FontSize="12"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="{DynamicResource SecondaryTextBrush}"
                                            Command="{Binding DataContext.OpenCustomEditorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Custom Plant Editor -->
                    <StackPanel Margin="0,14,0,0">
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="自定义植物" FontSize="15" FontWeight="SemiBold" DockPanel.Dock="Left" />
                            <Button Content="+ 添加" Padding="10,4" DockPanel.Dock="Right"
                                    Style="{StaticResource SidebarButtonStyle}"
                                    Command="{Binding AddCustomPlantCommand}" />
                        </DockPanel>

                        <Border Background="{DynamicResource ListItemBrush}" CornerRadius="10" Padding="10"
                                Visibility="{Binding IsCustomEditorOpen, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                            <StackPanel>
                                <TextBlock Text="植物名称" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBox Padding="10,6" Text="{Binding CustomEditName, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="性格" FontSize="12" FontWeight="SemiBold" Margin="0,12,0,6" />
                                <TextBox Padding="10,6" Text="{Binding CustomEditPersonality, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="自定义 Prompt" FontSize="12" FontWeight="SemiBold" Margin="0,12,0,6" />
                                <TextBox Padding="10,6" AcceptsReturn="True" TextWrapping="Wrap" Height="80"
                                         Text="{Binding CustomEditPrompt, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="聊天栏图片（本地文件）" FontSize="12" FontWeight="SemiBold" Margin="0,12,0,6" />
                                <DockPanel>
                                    <TextBlock Text="{Binding CustomEditImagePath}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" DockPanel.Dock="Left" />
                                    <Button Content="选择文件" Padding="10,4" DockPanel.Dock="Right"
                                            Style="{StaticResource SidebarButtonStyle}"
                                            Click="SelectCustomImage_Click" />
                                </DockPanel>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="{Binding DeleteButtonText}" Padding="10,4" Margin="0,0,4,0"
                                            Style="{StaticResource SidebarButtonStyle}"
                                            Command="{Binding DeleteCustomPlantCommand}" />
                                    <Button Grid.Column="1" Content="恢复初始" Padding="10,4" Margin="4,0,4,0"
                                            Style="{StaticResource SidebarButtonStyle}"
                                            Command="{Binding ResetSystemPlantCommand}" />
                                    <Button Grid.Column="2" Content="保存" Padding="10,4" Margin="4,0,0,0"
                                            Style="{StaticResource SidebarButtonStyle}"
                                            Command="{Binding SaveCustomPlantCommand}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Right Panel: Chat Area -->
        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="96" Height="96" CornerRadius="12" Background="{DynamicResource ListItemBrush}"
                            ClipToBounds="True" Margin="0,0,12,0">
                        <Grid>
                            <TextBlock Text="{Binding PlantEmoji}" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <Image Source="{Binding PlantImageSource}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="16" FontWeight="SemiBold"
                                   Text="{Binding PlantName, StringFormat='和 {0} 聊天', Mode=OneWay}" />
                        <TextBlock Text="{Binding Mood, StringFormat='状态：{0}'}" Margin="0,6,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" />
                    </StackPanel>
                </Grid>

                <ListBox Grid.Row="1" ItemsSource="{Binding Messages}" BorderThickness="0"
                         Background="Transparent" Margin="0,0,0,12"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         HorizontalContentAlignment="Stretch"
                         x:Name="MessageListBox">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" Padding="12" CornerRadius="10"
                                    Background="{DynamicResource ListItemBrush}">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="{Binding Sender}" FontWeight="SemiBold" DockPanel.Dock="Left" />
                                        <TextBlock Text="{Binding Time, StringFormat={}{0:HH:mm}}" FontSize="11"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" DockPanel.Dock="Right" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Content}" Margin="0,6,0,0" TextWrapping="Wrap"
                                               MaxWidth="{Binding ElementName=MessageListBox, Path=ActualWidth}"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Input Area -->
                <Border Grid.Row="2" Background="{DynamicResource ListItemBrush}" CornerRadius="10" Padding="8">
                    <DockPanel>
                        <Button Content="发送" Width="80" Margin="8,0,0,0"
                                Style="{StaticResource SidebarButtonStyle}"
                                Command="{Binding SendCommand}" DockPanel.Dock="Right" />
                        <TextBox Padding="10,8" BorderThickness="0" Background="Transparent"
                                 Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="False"
                                 KeyDown="InputTextBox_KeyDown" />
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
