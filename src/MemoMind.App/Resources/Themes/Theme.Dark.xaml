<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AppBackgroundColor">#0F172A</Color>
    <Color x:Key="SidebarColor">#111827</Color>
    <Color x:Key="PrimaryTextColor">#E5E7EB</Color>
    <Color x:Key="SecondaryTextColor">#A1A1AA</Color>
    <Color x:Key="CardColor">#1F2937</Color>
    <Color x:Key="SidebarButtonColor">#374151</Color>
    <Color x:Key="SidebarButtonForegroundColor">#F9FAFB</Color>
    <Color x:Key="ListItemColor">#111827</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{DynamicResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{DynamicResource SidebarColor}" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{DynamicResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{DynamicResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{DynamicResource CardColor}" />
    <SolidColorBrush x:Key="SidebarButtonBackgroundBrush" Color="{DynamicResource SidebarButtonColor}" />
    <SolidColorBrush x:Key="SidebarButtonForegroundBrush" Color="{DynamicResource SidebarButtonForegroundColor}" />
    <SolidColorBrush x:Key="ListItemBrush" Color="{DynamicResource ListItemColor}" />
</ResourceDictionary>
